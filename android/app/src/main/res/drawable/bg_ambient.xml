<?xml version="1.0" encoding="utf-8"?>
<!--
  环境层背景
  ==========
  基础渐变 + 两团彩色光斑（青在左上、紫在右下）。

  这一层是所有玻璃的"折射对象"。上一版失败的直接原因就是这里太暗太平：
  纯深灰蓝背景上的半透明白，看起来只是一块灰片。
  加入彩色光斑后，同一张玻璃卡片在屏幕不同位置折射出不同色温 ——
  这正是澎湃"感知环境色，自然融合"的实现原理。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 淡蓝环境底色，让玻璃卡片随位置产生不同冷暖。 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/amb_mid"
                android:endColor="@color/amb_bottom"
                android:startColor="@color/amb_top"
                android:type="linear" />
        </shape>
    </item>

    <!-- 蓝色晨光：左上，覆盖标题与首张卡片 -->
    <item
        android:bottom="400dp"
        android:left="-180dp"
        android:right="40dp"
        android:top="-180dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="@color/amb_glow_cyan_out"
                android:gradientRadius="55%"
                android:startColor="@color/amb_glow_cyan"
                android:type="radial" />
        </shape>
    </item>

    <!-- 淡紫光斑：右下，制造柔和的空间层次 -->
    <item
        android:bottom="-260dp"
        android:left="80dp"
        android:right="-180dp"
        android:top="380dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="@color/amb_glow_violet_out"
                android:gradientRadius="55%"
                android:startColor="@color/amb_glow_violet"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
