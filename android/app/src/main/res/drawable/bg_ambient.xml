<?xml version="1.0" encoding="utf-8"?>
<!--
  环境层背景
  ==========
  三段线性渐变 + 顶部一团弥散光斑。

  这一层是整套玻璃材质的"折射对象"：玻璃卡片本身几乎是透明的，
  用户看到的层次感全部来自它下面这层环境色的明暗变化。
  所以环境层不能是纯色 —— 纯色背景上的玻璃会退化成一块灰片。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 基础渐变：自上而下由深到略亮再收暗，模拟自然光衰减 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/amb_top"
                android:centerColor="@color/amb_mid"
                android:endColor="@color/amb_bottom"
                android:type="linear" />
        </shape>
    </item>

    <!-- 光斑：偏上方的径向辉光，让顶部的玻璃卡片有可折射的亮部 -->
    <item
        android:bottom="240dp"
        android:left="-120dp"
        android:right="-40dp"
        android:top="-180dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="@color/amb_glow_fade"
                android:gradientRadius="60%"
                android:startColor="@color/amb_glow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
