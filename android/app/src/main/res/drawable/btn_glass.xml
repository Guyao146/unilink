<?xml version="1.0" encoding="utf-8"?>
<!--
  次级按钮（玻璃）
  ================
  与主按钮同构，但填充是半透明白 —— 让它"让位于内容"，
  这是 Liquid Glass 里控件层级的核心：只有一个操作值得用实色。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_control" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/r_control" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/glass_edge_dark"
                        android:startColor="@color/glass_edge_light"
                        android:type="linear" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/hairline"
                android:left="@dimen/hairline"
                android:right="@dimen/hairline"
                android:top="@dimen/hairline">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/r_control" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/glass_fill_bottom"
                        android:startColor="@color/glass_fill_top"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
