<?xml version="1.0" encoding="utf-8"?>
<!--
  输入框（内凹玻璃）
  ==================
  与按钮的明暗相反：顶部暗、底部亮 —— 靠这个反转让用户
  一眼分清"可点"与"可填"，不必依赖额外提示。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_control" />
            <gradient
                android:angle="270"
                android:endColor="@color/field_edge"
                android:startColor="@color/glass_edge_dark"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:bottom="@dimen/hairline"
        android:left="@dimen/hairline"
        android:right="@dimen/hairline"
        android:top="@dimen/hairline">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_control" />
            <solid android:color="@color/field_fill" />
        </shape>
    </item>
</layer-list>
