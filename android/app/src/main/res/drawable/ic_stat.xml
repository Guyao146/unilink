<!--
  状态栏小图标
  ============
  必须是纯白单色实心图形 —— Android 会把通知小图标当作蒙版处理，
  任何颜色与渐变都会被丢弃。因此这里用"两点一线"的实心简化版。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 连接线 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.6,15.1l8.8,-6.2l1.2,1.6l-8.8,6.2z" />

    <!-- 两个端点 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6.5,15.5a2.8,2.8 0 1,0 5.6,0a2.8,2.8 0 1,0 -5.6,0z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M14.4,8.5a2.8,2.8 0 1,0 5.6,0a2.8,2.8 0 1,0 -5.6,0z" />
</vector>

