<?xml version="1.0" encoding="utf-8"?>
<!--
  状态胶囊
  ========
  连接状态的载体。用胶囊而非纯文字，是为了让它在视觉上"独立于"
  背景漂浮 —— 状态是需要随时扫一眼的信息，得有自己的边界。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/r_pill" />
    <solid android:color="@color/glass_fill_bottom" />
    <stroke
        android:width="@dimen/hairline"
        android:color="@color/glass_edge_dark" />
</shape>
