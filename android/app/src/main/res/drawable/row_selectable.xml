<?xml version="1.0" encoding="utf-8"?>
<!-- 外观选项：选中时使用蓝色薄膜，未选中为透明行。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_row" />
            <solid android:color="@color/ac_primary_wash" />
            <stroke android:width="@dimen/hairline" android:color="@color/ac_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_row" />
            <solid android:color="@color/transparent" />
        </shape>
    </item>
</selector>