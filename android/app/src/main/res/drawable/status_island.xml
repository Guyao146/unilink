<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部状态岛：连接过程持续可见，但不挤占内容区。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_pill" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/r_pill" />
                    <solid android:color="@color/row_edge" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/hairline"
                android:left="@dimen/hairline"
                android:right="@dimen/hairline"
                android:top="@dimen/hairline">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/r_pill" />
                    <solid android:color="@color/row_fill" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
