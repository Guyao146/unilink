<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面骨架
  ==========
  内容区（可切换的 4 个页面）+ 悬浮 Dock。

  Dock 覆盖在内容之上，内容区底部靠 PageScroll 的 paddingBottom
  留出空间 —— 这样滚动时内容会从 Dock 底下穿过去，
  正是澎湃"悬浮框架，浏览更沉浸"的观感。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 页面容器：4 个页面同时存在，靠可见性切换。
         页面数量少且状态需要保留（输入框内容、日志滚动位置），
         用 ViewPager + Fragment 反而增加复杂度 -->
    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/page_home" />

        <include layout="@layout/page_link" />

        <include layout="@layout/page_sync" />

        <include layout="@layout/page_settings" />
    </FrameLayout>

    <!-- ═══════════ 悬浮 Dock ═══════════ -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/h_dock"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/sp_2xl"
        android:background="@drawable/dock_glass"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sp_sm"
        android:paddingEnd="@dimen/sp_sm">

        <LinearLayout
            android:id="@+id/tabHome"
            style="@style/DockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_home"
                android:src="@drawable/ic_tab_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_home"
                android:textSize="@dimen/t_dock" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabLink"
            style="@style/DockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_link"
                android:src="@drawable/ic_tab_scan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_link"
                android:textSize="@dimen/t_dock" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSync"
            style="@style/DockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_sync"
                android:src="@drawable/ic_tab_sync" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_sync"
                android:textSize="@dimen/t_dock" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            style="@style/DockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_settings"
                android:src="@drawable/ic_tab_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_settings"
                android:textSize="@dimen/t_dock" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
