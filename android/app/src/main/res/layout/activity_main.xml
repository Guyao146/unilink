<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="未启动" />

    <TextView
        android:id="@+id/tvListener"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:text="通知读取权限：检测中…" />

    <!-- ================= 扫码登录 authentik ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1A1F2B"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_none"
            android:textColor="#D8DEE9"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etQrServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="扫码登录服务地址，如 https://qr.example.com"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColorHint="#7A8699"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="登录 authentik" />

            <Button
                android:id="@+id/btnScanLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="扫码登录" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="退出" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/etServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="服务器地址，如 ws://192.168.1.100:8765/ws"
        android:inputType="textUri"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="房间码"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="访问令牌（可空）"
            android:inputType="textPassword"
            android:singleLine="true" />
    </LinearLayout>

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="设备名（显示在电脑端）"
        android:inputType="text"
        android:singleLine="true" />

    <Switch
        android:id="@+id/swMirror"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="把本机状态栏通知同步给电脑" />

    <Switch
        android:id="@+id/swRecvNotify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="接收电脑的消息与通知提醒" />

    <Switch
        android:id="@+id/swRecvClip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自动接收电脑剪贴板" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="连接并保持后台" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="断开" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAccess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="授予通知使用权" />

        <Button
            android:id="@+id/btnPerm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="允许弹出通知" />
    </LinearLayout>

    <Button
        android:id="@+id/btnA11y"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开启无障碍（电脑回复自动发送，推荐）" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShareClip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="发送剪贴板到电脑" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清空日志" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="#101418"
        android:fadingEdge="vertical">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="#9FE8B4"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
