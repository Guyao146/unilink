<?xml version="1.0" encoding="utf-8"?>
<!--
  页面 1 · 首页
  =============
  只回答一个问题：**现在通不通？**

  超大状态字 + 一句说明 + 一个主操作。整页只有 3 个信息单元，
  这是"降低信息密度"最直接的体现 —— 首页不该是控制面板。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageHome"
    style="@style/PageScroll">

    <LinearLayout style="@style/PageColumn">

        <!-- 顶部留白：让标题从屏幕上方"降下来"，不贴状态栏 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/sp_3xl" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            style="@style/TextDisplay" />

        <!-- ═══ 状态卡：整页的主角 ═══ -->
        <LinearLayout
            android:layout_marginTop="@dimen/sp_2xl"
            android:paddingTop="@dimen/sp_2xl"
            android:paddingBottom="@dimen/sp_2xl"
            style="@style/CardGlass">

            <!-- 状态圆点 + 大字 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="@dimen/sp_md"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_idle"
                    style="@style/TextHero" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_sm"
                android:text="@string/status_idle_hint"
                style="@style/TextLabel" />

            <Button
                android:id="@+id/btnStart"
                android:layout_marginTop="@dimen/sp_xl"
                android:text="@string/btn_start"
                style="@style/BtnPrimary" />

            <Button
                android:id="@+id/btnStop"
                android:layout_marginTop="@dimen/sp_sm"
                android:text="@string/btn_stop"
                style="@style/BtnGlass" />
        </LinearLayout>

        <!-- ═══ 快捷操作 ═══ -->
        <LinearLayout
            android:layout_marginTop="@dimen/card_gap"
            style="@style/CardGlass">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sp_md"
                android:text="@string/sec_quick"
                style="@style/TextTitle" />

            <Button
                android:id="@+id/btnShareClip"
                android:text="@string/btn_share_clip"
                style="@style/BtnGlass" />

            <Button
                android:id="@+id/btnScanLogin"
                android:layout_marginTop="@dimen/sp_sm"
                android:text="@string/btn_scan"
                style="@style/BtnGlass" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
