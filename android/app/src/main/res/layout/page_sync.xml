<?xml version="1.0" encoding="utf-8"?>
<!--
  页面 3 · 同步
  =============
  三个开关一行一个（60dp 行高，各自有玻璃底），下方是活动日志。

  上一版三个开关紧贴堆叠、没有边界，是"密度过高"最刺眼的地方。
  现在每个开关是一张独立的行卡，行与行之间 8dp 间距。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSync"
    style="@style/PageScroll">

    <LinearLayout style="@style/PageColumn">

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/sp_3xl" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_sync"
            style="@style/TextDisplay" />

        <!-- ═══ 开关组 ═══ -->
        <LinearLayout
            android:layout_marginTop="@dimen/sp_2xl"
            style="@style/CardGlass">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sp_md"
                android:text="@string/sec_sync_what"
                style="@style/TextTitle" />

            <Switch
                android:id="@+id/swMirror"
                android:text="@string/sw_mirror"
                style="@style/SwitchRow" />

            <Switch
                android:id="@+id/swRecvNotify"
                android:layout_marginTop="@dimen/sp_sm"
                android:text="@string/sw_recv_notify"
                style="@style/SwitchRow" />

            <Switch
                android:id="@+id/swRecvClip"
                android:layout_marginTop="@dimen/sp_sm"
                android:text="@string/sw_recv_clip"
                style="@style/SwitchRow" />
        </LinearLayout>

        <!-- ═══ 活动日志 ═══ -->
        <LinearLayout
            android:layout_marginTop="@dimen/card_gap"
            style="@style/CardGlass">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sec_activity"
                    style="@style/TextTitle" />

                <TextView
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/row_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingEnd="@dimen/sp_lg"
                    android:paddingTop="@dimen/sp_sm"
                    android:paddingBottom="@dimen/sp_sm"
                    android:text="@string/btn_clear"
                    style="@style/TextLabel" />
            </LinearLayout>

            <!-- 固定高度、只显示最新日志：避免与页面滚动争夺手势。 -->
            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="@dimen/sp_lg"
                android:background="@drawable/log_surface"
                android:ellipsize="start"
                android:fontFamily="monospace"
                android:gravity="bottom"
                android:lineSpacingMultiplier="1.4"
                android:maxLines="12"
                android:padding="@dimen/sp_lg"
                android:text="@string/log_empty"
                android:textColor="@color/log_text"
                android:textIsSelectable="true"
                android:textSize="@dimen/t_caption" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
