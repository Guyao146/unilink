<?xml version="1.0" encoding="utf-8"?>
<!--
  UniLink 设计系统 · 色板（深色）
  ===============================
同名覆盖。深色下玻璃的表达方式相反：

    · 浅色 = 白玻璃叠在亮底上；
    · 深色 = 低透明白浮在深夜蓝底上。

   这一版把深色背景从“近黑”提到“深夜蓝”
   （#111C33 / #16233D / #0D1525），玻璃填充提到 20-30% 白、顶缘高光提到 35% 白。
   理由：背景越接近纯黑，半透明白越无处可折射，
   卡片就糊成一片灰；留出中间明度梯度，轮廓和光斑色温变化才看得出。
   光斑同步提到 30% 透明度，“感知环境色”在夜间依然存在，只是更内敛。

   强调色用 iOS 深色系统色（#0A84FF / #30D158 / #FF9F0A / #FF453A），
   在暗底上有足够对比度。
-->
<resources>

    <!-- ── 环境层：深夜蓝，光斑更内敛 ── -->
    <color name="amb_top">#111C33</color>
    <color name="amb_mid">#16233D</color>
    <color name="amb_bottom">#0D1525</color>

    <color name="amb_glow_cyan">#4D12A5E8</color>
    <color name="amb_glow_cyan_out">#0012A5E8</color>
    <color name="amb_glow_violet">#4D8F7BFF</color>
    <color name="amb_glow_violet_out">#008F7BFF</color>

    <!-- ── 玻璃材质：低透明白 + 顶缘高光 ── -->
    <color name="glass_fill_top">#33FFFFFF</color>
    <color name="glass_fill_bottom">#1EFFFFFF</color>
    <color name="glass_edge_light">#5AFFFFFF</color>
    <color name="glass_edge_dark">#2B000000</color>

    <color name="row_fill">#2BFFFFFF</color>
    <color name="row_edge">#38FFFFFF</color>

    <color name="field_fill">#30000000</color>
    <color name="field_edge">#3DFFFFFF</color>

    <color name="glass_press">#2EFFFFFF</color>
    <color name="glass_ripple">#404C8DFF</color>

    <!-- ── 文字 ── -->
    <color name="ink_primary">#F4F8FD</color>
    <color name="ink_secondary">#B9C5DA</color>
    <color name="ink_tertiary">#8B99B1</color>
    <color name="ink_on_accent">#FFFFFF</color>

    <!-- ── 强调色：iOS 深色系统色 ── -->
    <color name="ac_primary">#0A84FF</color>
    <color name="ac_primary_dim">#0066DE</color>
    <color name="ac_primary_wash">#330A84FF</color>

    <color name="ac_violet">#9D8CFF</color>
    <color name="ac_violet_wash">#339D8CFF</color>

    <color name="ac_success">#30D158</color>
    <color name="ac_success_wash">#2630D158</color>
    <color name="ac_warn">#FF9F0A</color>
    <color name="ac_warn_wash">#26FF9F0A</color>
    <color name="ac_danger">#FF453A</color>
    <color name="ac_danger_wash">#26FF453A</color>

    <color name="switch_on">#30D158</color>
    <color name="switch_off">#59787880</color>

    <!-- 悬浮 Dock：深色下压得更实，稳住底部 -->
    <color name="dock_fill_top">#F21B2540</color>
    <color name="dock_fill_bottom">#D9141C31</color>

    <color name="log_bg">#F20F1726</color>
    <color name="log_text">#8FE3B5</color>
</resources>
