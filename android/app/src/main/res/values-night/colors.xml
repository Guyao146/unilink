<?xml version="1.0" encoding="utf-8"?>
<!--
  UniLink 设计系统 · 色板（深色）
  ===============================
同名覆盖。

   石墨中性灰方向（iOS 标准灰系）
   ──────────────────────────────
   环境层去掉蓝色相，转为纯中性灰（#1C1C1E / #161618 / #0F0F11），
   与 iOS systemBackground 对齐。光斑降为近乎环境光的微弱灰白——
   灰底上只保留空间层次，不冒出突兀的彩色。

   玻璃 = 白透明叠在灰底上，呈现为更亮的灰；
   文字用 iOS label 体系，ink_tertiary 对齐 systemGray。
   强调色沿用 iOS 深色系统色（#0A84FF / #30D158 / #FF9F0A / #FF453A），
   与灰底是经典搭配，不需要用户重新建立心智。
-->
<resources>

    <!-- ── 环境层：中性石墨灰，无色相（干净百搭的基调）── -->
    <color name="amb_top">#1C1C1E</color>
    <color name="amb_mid">#161618</color>
    <color name="amb_bottom">#0F0F11</color>

    <!-- 光斑降为近乎环境光的微白：灰底上只留空间层次，不冒突兀彩色 -->
    <color name="amb_glow_cyan">#14666C77</color>
    <color name="amb_glow_cyan_out">#00666C77</color>
    <color name="amb_glow_violet">#108E8E98</color>
    <color name="amb_glow_violet_out">#008E8E98</color>

    <!-- ── 玻璃材质：白透明叠在灰底上 = 更亮的灰，轮廓明确 ── -->
    <color name="glass_fill_top">#2EFFFFFF</color>
    <color name="glass_fill_bottom">#1BFFFFFF</color>
    <color name="glass_edge_light">#4DFFFFFF</color>
    <color name="glass_edge_dark">#20000000</color>

    <color name="row_fill">#26FFFFFF</color>
    <color name="row_edge">#33FFFFFF</color>

    <color name="field_fill">#20000000</color>
    <color name="field_edge">#33FFFFFF</color>

    <color name="glass_press">#2AFFFFFF</color>
    <color name="glass_ripple">#338E8E93</color>

    <!-- ── 文字：iOS label 体系（systemGray 对齐）── -->
    <color name="ink_primary">#F2F2F7</color>
    <color name="ink_secondary">#C7C7CC</color>
    <color name="ink_tertiary">#8E8E93</color>
    <color name="ink_on_accent">#FFFFFF</color>

    <!-- ── 强调色：iOS 深色系统色 ── -->
    <color name="ac_primary">#0A84FF</color>
    <color name="ac_primary_dim">#0066DE</color>
    <color name="ac_primary_wash">#330A84FF</color>

    <color name="ac_violet">#9D8CFF</color>
    <color name="ac_violet_wash">#339D8CFF</color>

    <color name="ac_success">#30D158</color>
    <color name="ac_success_wash">#2630D158</color>
    <color name="ac_warn">#FF9F0A</color>
    <color name="ac_warn_wash">#26FF9F0A</color>
    <color name="ac_danger">#FF453A</color>
    <color name="ac_danger_wash">#26FF453A</color>

    <color name="switch_on">#30D158</color>
    <color name="switch_off">#59787880</color>

    <!-- 悬浮 Dock：更实的灰，压住滚动内容 -->
    <color name="dock_fill_top">#F2262628</color>
    <color name="dock_fill_bottom">#D91C1C1E</color>

    <color name="log_bg">#F21C1C1E</color>
    <color name="log_text">#9BE8C1</color>
</resources>
