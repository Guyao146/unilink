<?xml version="1.0" encoding="utf-8"?>
<!--
  UniLink 设计系统 · 色板
  =======================
  上一版失败在**对比度不足**：环境层太深、玻璃填充太淡（12% 白），
  结果整屏是一片糊在一起的深蓝灰，卡片边界几乎看不见。

  这一版按澎湃"柔光玻璃"的实际观感重做：
   · 环境层抬亮并加大层次，让玻璃有明确可折射的明暗
   · 玻璃填充提到 ~10~18% 白，卡片边界清晰可辨
   · 引入**彩色光斑**（青 + 紫）：澎湃的"感知环境色"靠的就是
     背景里流动的彩色辉光，纯灰背景永远做不出生命感
   · 强调色改用更饱和的青蓝，在深底上有足够存在感

  命名：amb_ 环境层 / glass_ 玻璃 / ink_ 文字 / ac_ 强调
-->
<resources>

    <!-- ── 环境层 ──
         比上一版整体抬亮约 60%，且顶部与底部差值加大，
         玻璃卡片才有可折射的明暗梯度 -->
    <color name="amb_top">#131A2B</color>
    <color name="amb_mid">#1B2540</color>
    <color name="amb_bottom">#101726</color>

    <!-- 彩色光斑：一青一紫，斜向分布。
         这是"感知环境色"的来源 —— 玻璃在不同位置折射出不同色温 -->
    <color name="amb_glow_cyan">#4D22D3EE</color>
    <color name="amb_glow_cyan_out">#0022D3EE</color>
    <color name="amb_glow_violet">#3D8B5CF6</color>
    <color name="amb_glow_violet_out">#008B5CF6</color>

    <!-- ── 玻璃材质 ──
         填充提亮到 18%/8%，卡片轮廓明确；
         描边顶部 55% 白是镜面高光的关键 -->
    <color name="glass_fill_top">#2EFFFFFF</color>
    <color name="glass_fill_bottom">#14FFFFFF</color>
    <color name="glass_edge_light">#8CFFFFFF</color>
    <color name="glass_edge_dark">#0FFFFFFF</color>

    <!-- 行内嵌层：卡片里的每一行有自己的浅玻璃底，
         这样"一行一件事"才有视觉边界 -->
    <color name="row_fill">#12FFFFFF</color>
    <color name="row_edge">#1AFFFFFF</color>

    <!-- 输入框：内凹，用暗填充 -->
    <color name="field_fill">#33060B16</color>
    <color name="field_edge">#26FFFFFF</color>

    <!-- 点按光效：触点泛起的暖白（澎湃"点按有光"）-->
    <color name="glass_press">#33FFFFFF</color>
    <color name="glass_ripple">#4022D3EE</color>

    <!-- ── 文字 ── -->
    <color name="ink_primary">#F5F8FD</color>
    <color name="ink_secondary">#AEBACE</color>
    <color name="ink_tertiary">#7A8699</color>
    <color name="ink_on_accent">#04121A</color>

    <!-- ── 强调色 ── -->
    <color name="ac_primary">#22D3EE</color>
    <color name="ac_primary_dim">#0E9BB5</color>
    <color name="ac_primary_wash">#2622D3EE</color>

    <color name="ac_violet">#A78BFA</color>
    <color name="ac_violet_wash">#26A78BFA</color>

    <color name="ac_success">#4ADE80</color>
    <color name="ac_success_wash">#264ADE80</color>
    <color name="ac_warn">#FBBF24</color>
    <color name="ac_warn_wash">#26FBBF24</color>
    <color name="ac_danger">#FB7185</color>
    <color name="ac_danger_wash">#26FB7185</color>

    <!-- 悬浮 Dock：比卡片更实，因为它要压住滚动的内容 -->
    <color name="dock_fill_top">#59303C5C</color>
    <color name="dock_fill_bottom">#40202B44</color>

    <!-- 日志：深底衬托等宽文本，明确区别于可操作区域 -->
    <color name="log_bg">#59060B16</color>
    <color name="log_text">#7DD3A0</color>

    <color name="transparent">#00000000</color>
</resources>
