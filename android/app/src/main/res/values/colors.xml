<?xml version="1.0" encoding="utf-8"?>
<!--
  UniLink 设计系统 · 色板
  =======================
  上一版失败在**对比度不足**：环境层太深、玻璃填充太淡（12% 白），
  结果整屏是一片糊在一起的深蓝灰，卡片边界几乎看不见。

  这一版按澎湃"柔光玻璃"的实际观感重做：
   · 环境层抬亮并加大层次，让玻璃有明确可折射的明暗
   · 玻璃填充提到 ~10~18% 白，卡片边界清晰可辨
   · 引入**彩色光斑**（青 + 紫）：澎湃的"感知环境色"靠的就是
     背景里流动的彩色辉光，纯灰背景永远做不出生命感
   · 强调色改用更饱和的青蓝，在深底上有足够存在感

  命名：amb_ 环境层 / glass_ 玻璃 / ink_ 文字 / ac_ 强调
-->
<resources>

    <!-- ── 环境层 ──
         比上一版整体抬亮约 60%，且顶部与底部差值加大，
         玻璃卡片才有可折射的明暗梯度 -->
    <color name="amb_top">#EAF5FF</color>
    <color name="amb_mid">#DDEAFB</color>
    <color name="amb_bottom">#F7F9FF</color>

    <!-- 彩色光斑：一青一紫，斜向分布。
         这是"感知环境色"的来源 —— 玻璃在不同位置折射出不同色温 -->
    <color name="amb_glow_cyan">#7047C9FF</color>
    <color name="amb_glow_cyan_out">#0047C9FF</color>
    <color name="amb_glow_violet">#5D9F83FF</color>
    <color name="amb_glow_violet_out">#009F83FF</color>

    <!-- ── 玻璃材质 ──
         填充提亮到 18%/8%，卡片轮廓明确；
         描边顶部 55% 白是镜面高光的关键 -->
    <color name="glass_fill_top">#D9FFFFFF</color>
    <color name="glass_fill_bottom">#A8F5F8FF</color>
    <color name="glass_edge_light">#EEFFFFFF</color>
    <color name="glass_edge_dark">#2B54709E</color>

    <!-- 行内嵌层：卡片里的每一行有自己的浅玻璃底，
         这样"一行一件事"才有视觉边界 -->
    <color name="row_fill">#80FFFFFF</color>
    <color name="row_edge">#29446480</color>

    <!-- 输入框：内凹，用暗填充 -->
    <color name="field_fill">#73EDF3FB</color>
    <color name="field_edge">#36516E94</color>

    <!-- 点按光效：触点泛起的暖白（澎湃"点按有光"）-->
    <color name="glass_press">#30FFFFFF</color>
    <color name="glass_ripple">#384C8DFF</color>

    <!-- ── 文字 ── -->
    <color name="ink_primary">#15233A</color>
    <color name="ink_secondary">#566983</color>
    <color name="ink_tertiary">#8190A5</color>
    <color name="ink_on_accent">#FFFFFF</color>

    <!-- ── 强调色 ── -->
    <color name="ac_primary">#287BFF</color>
    <color name="ac_primary_dim">#1764E7</color>
    <color name="ac_primary_wash">#254B8DFF</color>

    <color name="ac_violet">#7C62E8</color>
    <color name="ac_violet_wash">#267C62E8</color>

    <color name="ac_success">#4ADE80</color>
    <color name="ac_success_wash">#264ADE80</color>
    <color name="ac_warn">#FBBF24</color>
    <color name="ac_warn_wash">#26FBBF24</color>
    <color name="ac_danger">#FB7185</color>
    <color name="ac_danger_wash">#26FB7185</color>

    <!-- 悬浮 Dock：比卡片更实，因为它要压住滚动的内容 -->
    <color name="dock_fill_top">#DBFFFFFF</color>
    <color name="dock_fill_bottom">#BFF1F6FF</color>

    <!-- 日志：深底衬托等宽文本，明确区别于可操作区域 -->
    <color name="log_bg">#B80E1B2E</color>
    <color name="log_text">#B9F3D4</color>

    <color name="transparent">#00000000</color>
</resources>
