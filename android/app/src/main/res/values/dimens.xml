<?xml version="1.0" encoding="utf-8"?>
<!--
  UniLink 设计系统 · 尺度
  =======================
  两套语言各取所长：

   · 澎湃 OS —— 超大标题、大圆角、低信息密度、同心圆角。
   · iOS —— 字阶对齐 HIG（Large Title 34 → Footnote 12），
     控件端胶囊化（iOS 26 Liquid Glass 的按钮 / Dock 全圆）。

  字阶：34 / 28 / 20 / 16 / 14 / 12 / 10
  圆角遵循同心圆角原则：内层半径 = 外层半径 − 两者间距。
  例：卡片 r=26dp，内边距 6dp，则内部行 r=20dp 附近。
-->
<resources>

    <!-- ── 圆角（同心阶梯）── -->
    <dimen name="r_sheet">32dp</dimen>
    <dimen name="r_card">26dp</dimen>
    <dimen name="r_row">16dp</dimen>
    <dimen name="r_control">14dp</dimen>
    <dimen name="r_btn">999dp</dimen>
    <dimen name="r_icon">12dp</dimen>
    <dimen name="r_inner">12dp</dimen>
    <dimen name="r_pill">999dp</dimen>

    <!-- ── 间距 ── -->
    <dimen name="sp_xs">4dp</dimen>
    <dimen name="sp_sm">8dp</dimen>
    <dimen name="sp_md">12dp</dimen>
    <dimen name="sp_lg">16dp</dimen>
    <dimen name="sp_xl">20dp</dimen>
    <dimen name="sp_2xl">28dp</dimen>
    <dimen name="sp_3xl">40dp</dimen>

    <dimen name="gutter">20dp</dimen>
    <dimen name="card_pad">20dp</dimen>
    <dimen name="card_gap">16dp</dimen>

    <!-- 页面底部留白：给悬浮 Dock 让出空间 -->
    <dimen name="dock_clearance">112dp</dimen>

    <dimen name="hairline">1dp</dimen>

    <!-- ── 行与控件 ──
         60dp 行高一行只承载一件事；
         50dp 控件高配胶囊圆角 = iOS / 澎湃共同的主按钮形态 -->
    <dimen name="h_row">60dp</dimen>
    <dimen name="h_control">50dp</dimen>
    <dimen name="h_icon">32dp</dimen>
    <dimen name="h_dock">64dp</dimen>

    <!-- ── 字号（HIG 字阶的中文适配）── -->
    <dimen name="t_display">34sp</dimen>
    <dimen name="t_hero">28sp</dimen>
    <dimen name="t_title">20sp</dimen>
    <dimen name="t_body">16sp</dimen>
    <dimen name="t_label">14sp</dimen>
    <dimen name="t_caption">12sp</dimen>
    <dimen name="t_dock">10sp</dimen>
</resources>
