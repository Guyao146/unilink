<?xml version="1.0" encoding="utf-8"?>
<!--
  备份排除规则（Android 12+ 走 dataExtractionRules）
  排除原因同 backup_rules.xml：加密令牌换机后无法解密，且不宜外流。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="unilink_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="unilink_auth.xml" />
    </device-transfer>
</data-extraction-rules>
