# UniLink 扫码登录服务 —— 环境变量
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# 本服务对外可访问的根地址（反代后的地址，必须 https）
UNILINK_BASE_URL=https://gateway.mcylyr.cn

# authentik 根地址
UNILINK_AUTHENTIK_URL=https://login.mcylyr.cn

# 下游客户端 ID —— 必须与 authentik 里 OAuth Source 的 Slug 及 Consumer key 一致
UNILINK_CLIENT_ID=unilink-qr

# 客户端密钥。生成方式：
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# 必须与 authentik 里该 Source 的 Consumer secret 完全一致，且长度 >= 24
UNILINK_CLIENT_SECRET=

# 手机 App 在 authentik 上注册的 public client（对应 OAuth2 Provider 的 Client ID）
UNILINK_APP_CLIENT_ID=unilink-mobile
UNILINK_APP_REDIRECT_URI=unilink://auth/callback
