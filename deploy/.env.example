# UniLink 扫码登录服务 —— 环境变量
# 复制为 .env 后填写。切勿提交到版本库。
#
# 不想填配置文件？把下面三项全部留空（或干脆只要这一个 compose 文件），
# 启动后服务会进入「首次配置模式」：
# 浏览器打开反代后的 https 地址的 /setup，在网页上填配置即可（无需令牌）。
# 之后想改任何配置，打开 /admin 面板在线修改，无需重启或改文件。
#
# .env 只在面板尚未配置该项时生效（优先级：网页后台 > .env > 默认值）。
# 面板里改过的值会覆盖这里的同名项。

# ── 必填 ──────────────────────────────────────────────

# 本服务对外可访问的根地址（反代后的地址，必须 https）
UNILINK_BASE_URL=https://gateway.example.com

# authentik 根地址
UNILINK_AUTHENTIK_URL=https://login.example.com

# 客户端密钥。生成：
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# 必须与 authentik 里该 OAuth Source 的 Consumer secret 完全一致，长度 >= 24
UNILINK_CLIENT_SECRET=

# ── 可选（默认值适用于多数情况）────────────────────────

# 下游客户端 ID —— 必须与 authentik 里 OAuth Source 的 Slug 和 Consumer key 一致
UNILINK_CLIENT_ID=unilink-qr

# 手机 App 在 authentik 上注册的 public client（OAuth2 Provider 的 Client ID）
UNILINK_APP_CLIENT_ID=unilink-mobile
UNILINK_APP_REDIRECT_URI=unilink://auth/callback
# App 申请的 scopes；offline_access 用于取得 refresh_token 静默续期
UNILINK_APP_SCOPES=openid profile email offline_access

# 时效（秒）：二维码/登录会话、授权码、本服务签发的令牌
UNILINK_LOGIN_TTL=180
UNILINK_CODE_TTL=60
UNILINK_TOKEN_TTL=300
# 同时存活的扫码会话上限，防止反复打开 /authorize 打爆内存
UNILINK_MAX_SESSIONS=500

# 白名单（逗号或空白分隔多个值），都留空表示不限制
# UNILINK_ALLOWED_SUBS=alice@example.com,bob@example.com
# UNILINK_ALLOWED_GROUPS=staff,admins
UNILINK_ALLOWED_SUBS=
UNILINK_ALLOWED_GROUPS=

# 监听端口（一般不用改；若改了，反代与自检命令里的 8790 也要同步改）
# UNILINK_PORT=8790
